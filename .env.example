# Copy this file to ".env" and edit the values. NEVER commit ".env".

# --- Flask ---
# development | production | testing. Anything else (a typo such as 'prod') stops the site from starting. A deployment MUST set FLASK_ENV=production: with it unset,
# wsgi.py refuses to start under a WSGI server (only `python -m flask --app wsgi run` falls back to development, for a local run).
FLASK_ENV=development
# Signs the session cookie. REQUIRED in production (at least 32 random characters; the app refuses to start without one). Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-string

# --- MySQL: two non-root accounts (the MySQL root password is never stored here) ---
# Runtime account used by the website: SELECT/INSERT/UPDATE/DELETE only.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=gta6_vi
DB_USER=valkyrie_app
DB_PASSWORD=change_me

# Optional here, REQUIRED in production: the path of the database server's CA certificate (a PEM file; never commit it). With it, the connection verifies the
# server's certificate and host name; DB_HOST must then be the host name in that certificate. Managed MySQL services hand out this file. See docs/HOSTING.md.
# DB_SSL_CA=/etc/secrets/db-ca.pem

# Setup/migration account used only by scripts.setup_db and scripts.init_db (can create/drop tables).
MIGRATE_DB_USER=valkyrie_migrator
MIGRATE_DB_PASSWORD=change_me_too

# Separate database used only by pytest (name MUST end with _test)
TEST_DB_NAME=gta6_vi_test

# --- Motion ---
# 0 (default): a visitor whose system asks for reduced motion (Windows "Show animations" off) or who has data saver on sees
# a Play button instead of footage that starts by itself. 1: footage, the cast reel, the region explorer and the garage start
# by themselves for everyone (footage muted, with a pause button). A visitor can always switch it in the footer.
TV_AUTOPLAY_ALWAYS=0

# --- Deployment (required when FLASK_ENV=production; see docs/ACCOUNTS.md) ---
# Public origin(s) allowed to submit forms, comma-separated, https only in production. The Host header is not trusted for this.
# TV_PUBLIC_ORIGINS=https://valkyrie.example.org
# How many reverse proxies you control in front of the site (0 = none, the default). Only then are X-Forwarded-For/-Proto believed.
# Digits only, 0 to 5: a typo (abc, 1.5, -1, blank) stops the site from starting instead of quietly meaning 0.
# TV_TRUSTED_PROXIES=0
