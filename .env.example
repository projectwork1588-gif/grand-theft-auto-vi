# Copy this file to ".env" and edit the values. NEVER commit ".env".

# --- Flask ---
FLASK_ENV=development
SECRET_KEY=replace-with-a-long-random-string

# --- MySQL: two non-root accounts (the MySQL root password is never stored here) ---
# Runtime account used by the website: SELECT/INSERT/UPDATE/DELETE only.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=gta6_vi
DB_USER=valkyrie_app
DB_PASSWORD=change_me

# Setup/migration account used only by scripts.setup_db and scripts.init_db (can create/drop tables).
MIGRATE_DB_USER=valkyrie_migrator
MIGRATE_DB_PASSWORD=change_me_too

# Separate database used only by pytest (name MUST end with _test)
TEST_DB_NAME=gta6_vi_test

# --- Motion ---
# 0 (default): a visitor whose system asks for reduced motion (Windows "Show animations" off) or who has data saver on sees
# a Play button instead of footage that starts by itself. 1: footage, the cast reel, the region explorer and the garage start
# by themselves for everyone (footage muted, with a pause button). A visitor can always switch it in the footer.
TV_AUTOPLAY_ALWAYS=0
